
using Microsoft.Win32;
using System.Drawing.Drawing2D;
using System.Drawing.Text;
using System.Runtime.InteropServices;
using System.Text.Json;

namespace TareasBandeja;

// ---------- Modelo ----------
public class Tarea
{
    public string Titulo { get; set; } = "";
    public DateTime Fecha { get; set; } = DateTime.Today;
    public bool Hecha { get; set; }
}

sealed class RoundedButton : Button
{
    public Color AccentColor { get; set; } = Color.FromArgb(42, 42, 47);

    public RoundedButton()
    {
        FlatStyle = FlatStyle.Flat;
        FlatAppearance.BorderSize = 0;
        ForeColor = Color.White;
        Cursor = Cursors.Hand;
        ResizeRedraw = true;
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
        using var brush = new SolidBrush(Enabled ? AccentColor : Color.FromArgb(35, 35, 39));
        e.Graphics.FillRoundedRectangle(brush, ClientRectangle, 10);
        TextRenderer.DrawText(e.Graphics, Text, Font, ClientRectangle, ForeColor,
            TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter);
    }
}

static class GraphicsExtensions
{
    public static void FillRoundedRectangle(this Graphics graphics, Brush brush, Rectangle bounds, int radius)
    {
        using var path = new GraphicsPath();
        int diameter = radius * 2;
        path.AddArc(bounds.X, bounds.Y, diameter, diameter, 180, 90);
        path.AddArc(bounds.Right - diameter, bounds.Y, diameter, diameter, 270, 90);
        path.AddArc(bounds.Right - diameter, bounds.Bottom - diameter, diameter, diameter, 0, 90);
        path.AddArc(bounds.X, bounds.Bottom - diameter, diameter, diameter, 90, 90);
        path.CloseFigure();
        graphics.FillPath(brush, path);
    }
}

// ---------- Programa ----------
static class Program
{
    [STAThread]
    static void Main()
    {
        // Evita abrir dos copias (si no, saldrían dos iconos)
        using var mutex = new Mutex(true, "TareasBandejaUnica", out bool esLaPrimera);
        if (!esLaPrimera) return;

        ApplicationConfiguration.Initialize();
        Application.Run(new MainForm());
    }
}

// ---------- Ventana + icono de bandeja ----------
public class MainForm : Form
{
    const string ClaveInicio = @"Software\Microsoft\Windows\CurrentVersion\Run";
    const string NombreApp = "TareasBandeja";

    [DllImport("user32.dll", CharSet = CharSet.Auto)]
    static extern bool DestroyIcon(IntPtr handle);

    [DllImport("gdi32.dll")]
    static extern IntPtr CreateRoundRectRgn(int left, int top, int right, int bottom, int width, int height);

    readonly string rutaJson = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData),
        "TareasBandeja", "tareas.json");

    readonly List<Tarea> tareas = new();
    List<Tarea> visibles = new();   // tareas del día que se está mostrando

    readonly NotifyIcon tray = new();
    readonly DateTimePicker fecha = new();
    readonly CheckedListBox lista = new();
    readonly TextBox txtNueva = new();
    readonly RoundedButton btnAnadir = new();
    readonly RoundedButton btnEliminar = new();
    readonly CheckBox chkInicio = new();
    readonly Label titulo = new();
    readonly Label subtitulo = new();
    readonly Label etiquetaFecha = new();
    readonly Label resumen = new();
    readonly System.Windows.Forms.Timer reloj = new();

    Icon? iconoActual;
    DateTime ultimoDia = DateTime.Today;
    bool cargando;
    bool salir;
    bool primeraVez = true;

    public MainForm()
    {
        // --- Aspecto de la ventana ---
        Text = "Tareas";
        ClientSize = new Size(380, 520);
        FormBorderStyle = FormBorderStyle.None;
        BackColor = Color.FromArgb(13, 13, 15);
        ForeColor = Color.FromArgb(245, 245, 247);
        Region = Region.FromHrgn(CreateRoundRectRgn(0, 0, Width + 1, Height + 1, 26, 26));
        ShowInTaskbar = false;
        TopMost = true;
        StartPosition = FormStartPosition.Manual;
        KeyPreview = true;

        titulo.Text = "Mis tareas";
        titulo.Font = new Font("Segoe UI", 22, FontStyle.Bold);
        titulo.SetBounds(24, 22, 250, 38);

        subtitulo.Text = "Un pequeño paso cada día";
        subtitulo.ForeColor = Color.FromArgb(155, 155, 162);
        subtitulo.Font = new Font("Segoe UI", 10);
        subtitulo.SetBounds(26, 60, 260, 22);

        etiquetaFecha.Text = "HOY";
        etiquetaFecha.ForeColor = Color.FromArgb(125, 125, 133);
        etiquetaFecha.Font = new Font("Segoe UI", 8, FontStyle.Bold);
        etiquetaFecha.SetBounds(26, 100, 80, 20);

        fecha.Format = DateTimePickerFormat.Short;
        fecha.Font = new Font("Segoe UI", 10, FontStyle.Bold);
        fecha.CalendarForeColor = ForeColor;
        fecha.CalendarMonthBackground = Color.FromArgb(28, 28, 32);
        fecha.CalendarTitleBackColor = Color.FromArgb(28, 28, 32);
        fecha.CalendarTitleForeColor = ForeColor;
        fecha.BackColor = Color.FromArgb(28, 28, 32);
        fecha.ForeColor = ForeColor;
        fecha.SetBounds(26, 119, 145, 29);

        lista.SetBounds(24, 163, 332, 245);
        lista.CheckOnClick = true;
        lista.IntegralHeight = false;
        lista.BorderStyle = BorderStyle.None;
        lista.BackColor = Color.FromArgb(24, 24, 28);
        lista.ForeColor = Color.FromArgb(235, 235, 240);
        lista.Font = new Font("Segoe UI", 10);
        lista.DrawMode = DrawMode.OwnerDrawFixed;
        lista.ItemHeight = 42;
        lista.DrawItem += Lista_DrawItem;

        txtNueva.SetBounds(24, 424, 250, 34);
        txtNueva.PlaceholderText = "Nueva tarea...";
        txtNueva.BorderStyle = BorderStyle.FixedSingle;
        txtNueva.BackColor = Color.FromArgb(28, 28, 32);
        txtNueva.ForeColor = Color.FromArgb(245, 245, 247);
        txtNueva.Font = new Font("Segoe UI", 10);

        btnAnadir.Text = "+";
        btnAnadir.Font = new Font("Segoe UI", 18, FontStyle.Regular);
        btnAnadir.AccentColor = Color.FromArgb(88, 86, 214);
        btnAnadir.SetBounds(286, 422, 70, 38);

        btnEliminar.Text = "Eliminar seleccionada";
        btnEliminar.Font = new Font("Segoe UI", 9);
        btnEliminar.ForeColor = Color.FromArgb(220, 105, 112);
        btnEliminar.SetBounds(24, 474, 155, 30);

        chkInicio.Text = "Iniciar con Windows";
        chkInicio.ForeColor = Color.FromArgb(155, 155, 162);
        chkInicio.Font = new Font("Segoe UI", 9);
        chkInicio.SetBounds(210, 477, 145, 24);

        resumen.ForeColor = Color.FromArgb(125, 125, 133);
        resumen.Font = new Font("Segoe UI", 9);
        resumen.SetBounds(190, 100, 165, 20);
        resumen.TextAlign = ContentAlignment.TopRight;

        Controls.AddRange(new Control[] { titulo, subtitulo, etiquetaFecha, resumen, fecha, lista, txtNueva, btnAnadir, btnEliminar, chkInicio });
        AcceptButton = btnAnadir; // Enter = añadir

        // --- Icono de bandeja ---
        var menu = new ContextMenuStrip();
        menu.Items.Add("Abrir", null, (s, e) => Mostrar());
        menu.Items.Add("Salir", null, (s, e) => { salir = true; tray.Visible = false; Application.Exit(); });
        tray.ContextMenuStrip = menu;
        tray.MouseClick += (s, e) =>
        {
            if (e.Button != MouseButtons.Left) return;
            if (Visible) Hide(); else Mostrar();
        };

        // --- Datos ---
        Cargar();
        Refrescar();
        tray.Visible = true;

        // Aviso al arrancar si tienes tareas pendientes hoy
        int pendientes = PendientesHoy();
        if (pendientes > 0)
            tray.ShowBalloonTip(4000, "Tareas de hoy", $"Tienes {pendientes} tarea(s) pendiente(s)", ToolTipIcon.Info);

        // --- Eventos ---
        fecha.ValueChanged += (s, e) => Refrescar();
        btnAnadir.Click += (s, e) => Anadir();
        btnEliminar.Click += (s, e) => Eliminar();
        lista.ItemCheck += Lista_ItemCheck;
        lista.KeyDown += (s, e) => { if (e.KeyCode == Keys.Delete) Eliminar(); };
        KeyDown += (s, e) => { if (e.KeyCode == Keys.Escape) Hide(); };

        chkInicio.Checked = InicioActivado();
        chkInicio.CheckedChanged += (s, e) => CambiarInicio(chkInicio.Checked);

        // Cada minuto comprueba si ha cambiado el día (medianoche)
        reloj.Interval = 60_000;
        reloj.Tick += (s, e) =>
        {
            if (DateTime.Today == ultimoDia) return;
            ultimoDia = DateTime.Today;
            fecha.Value = DateTime.Today;
            Refrescar();
        };
        reloj.Start();
    }

    // La app arranca oculta (solo el icono de bandeja)
    protected override void SetVisibleCore(bool value)
    {
        if (primeraVez)
        {
            primeraVez = false;
            value = false;
            if (!IsHandleCreated) CreateHandle();
        }
        base.SetVisibleCore(value);
    }

    // Al pulsar la X no se cierra: se oculta
    protected override void OnFormClosing(FormClosingEventArgs e)
    {
        if (!salir && e.CloseReason == CloseReason.UserClosing)
        {
            e.Cancel = true;
            Hide();
        }
        base.OnFormClosing(e);
    }

    void Mostrar()
    {
        fecha.Value = DateTime.Today;
        var area = Screen.PrimaryScreen!.WorkingArea;
        Location = new Point(area.Right - Width - 10, area.Bottom - Height - 10);
        Show();
        WindowState = FormWindowState.Normal;
        Activate();
        txtNueva.Focus();
    }

    // ---------- Lógica de tareas ----------
    int PendientesHoy() => tareas.Count(t => t.Fecha.Date == DateTime.Today && !t.Hecha);

    void Anadir()
    {
        string titulo = txtNueva.Text.Trim();
        if (titulo == "") return;

        tareas.Add(new Tarea { Titulo = titulo, Fecha = fecha.Value.Date });
        txtNueva.Clear();
        Guardar();
        Refrescar();
    }

    void Eliminar()
    {
        int i = lista.SelectedIndex;
        if (i < 0) return;

        tareas.Remove(visibles[i]);
        Guardar();
        Refrescar();
    }

    void Lista_ItemCheck(object? sender, ItemCheckEventArgs e)
    {
        if (cargando) return;
        visibles[e.Index].Hecha = e.NewValue == CheckState.Checked;
        Guardar();
        ActualizarIcono();
    }

    void Refrescar()
    {
        cargando = true;
        lista.Items.Clear();
        visibles = tareas
            .Where(t => t.Fecha.Date == fecha.Value.Date)
            .OrderBy(t => t.Hecha)
            .ToList();
        foreach (var t in visibles)
            lista.Items.Add(t.Titulo, t.Hecha);
        cargando = false;

        int pendientes = visibles.Count(t => !t.Hecha);
        resumen.Text = pendientes == 0 ? "Todo al día" : $"{pendientes} pendiente{(pendientes == 1 ? "" : "s")}";

        ActualizarIcono();
    }

    void Lista_DrawItem(object? sender, DrawItemEventArgs e)
    {
        if (e.Index < 0 || e.Index >= lista.Items.Count) return;

        e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
        var tarea = visibles[e.Index];
        Color fondo = (e.State & DrawItemState.Selected) != 0
            ? Color.FromArgb(43, 43, 50)
            : Color.FromArgb(24, 24, 28);
        using var brush = new SolidBrush(fondo);
        e.Graphics.FillRectangle(brush, e.Bounds);

        var checkBounds = new Rectangle(e.Bounds.X + 12, e.Bounds.Y + 11, 20, 20);
        ControlPaint.DrawCheckBox(e.Graphics, checkBounds,
            tarea.Hecha ? ButtonState.Checked : ButtonState.Normal);
        var color = tarea.Hecha ? Color.FromArgb(125, 125, 133) : Color.FromArgb(235, 235, 240);
        TextRenderer.DrawText(e.Graphics, tarea.Titulo, lista.Font,
            new Rectangle(e.Bounds.X + 44, e.Bounds.Y, e.Bounds.Width - 52, e.Bounds.Height), color,
            TextFormatFlags.VerticalCenter | TextFormatFlags.EndEllipsis);
    }

    // ---------- Icono con número ----------
    void ActualizarIcono()
    {
        int n = PendientesHoy();

        using var bmp = new Bitmap(32, 32);
        using (var g = Graphics.FromImage(bmp))
        {
            g.SmoothingMode = SmoothingMode.AntiAlias;
            g.TextRenderingHint = TextRenderingHint.AntiAliasGridFit;
            g.Clear(Color.Transparent);

            // Verde si no queda nada, rojo si hay pendientes
            using var fondo = new SolidBrush(n == 0 ? Color.SeaGreen : Color.Crimson);
            g.FillEllipse(fondo, 0, 0, 31, 31);

            string texto = n > 99 ? "99+" : n.ToString();
            float tam = texto.Length == 1 ? 22 : texto.Length == 2 ? 18 : 12;
            using var fuente = new Font("Segoe UI", tam, FontStyle.Bold, GraphicsUnit.Pixel);
            using var formato = new StringFormat
            {
                Alignment = StringAlignment.Center,
                LineAlignment = StringAlignment.Center
            };
            g.DrawString(texto, fuente, Brushes.White, new RectangleF(0, 0, 32, 33), formato);
        }

        IntPtr handle = bmp.GetHicon();
        var nuevo = (Icon)Icon.FromHandle(handle).Clone();
        DestroyIcon(handle);

        tray.Icon = nuevo;
        iconoActual?.Dispose();
        iconoActual = nuevo;

        tray.Text = n == 0 ? "Sin tareas pendientes hoy" : $"{n} tarea(s) pendiente(s) hoy";
    }

    // ---------- Guardar / cargar ----------
    void Cargar()
    {
        try
        {
            if (!File.Exists(rutaJson)) return;
            var datos = JsonSerializer.Deserialize<List<Tarea>>(File.ReadAllText(rutaJson));
            if (datos != null) tareas.AddRange(datos);
        }
        catch (Exception ex)
        {
            MessageBox.Show("No se pudieron cargar las tareas: " + ex.Message);
        }
    }

    void Guardar()
    {
        Directory.CreateDirectory(Path.GetDirectoryName(rutaJson)!);
        File.WriteAllText(rutaJson, JsonSerializer.Serialize(tareas));
    }

    // ---------- Iniciar con Windows ----------
    static bool InicioActivado()
    {
        using var k = Registry.CurrentUser.OpenSubKey(ClaveInicio);
        return k?.GetValue(NombreApp) != null;
    }

    static void CambiarInicio(bool activar)
    {
        using var k = Registry.CurrentUser.OpenSubKey(ClaveInicio, true);
        if (k == null) return;
        if (activar) k.SetValue(NombreApp, $"\"{Application.ExecutablePath}\"");
        else k.DeleteValue(NombreApp, false);
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            tray.Dispose();
            iconoActual?.Dispose();
            reloj.Dispose();
        }
        base.Dispose(disposing);
    }
}
